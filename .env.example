# Docker Compose interpolation template: copy to .env and replace placeholders.
# No secret values belong here. Compose passes an explicit, role-scoped environment;
# it does NOT pass this file wholesale into any container.
# For non-Docker installs, use the separate per-role examples in README.md.
# The Node application itself does not automatically load .env files.

INTAKE_PUBLIC_URL=https://intake.example.com
INTAKE_DEFAULT_NOTIFY_EMAIL=ops@example.com
INTAKE_MAX_TTL=7d
# Seconds; 0 or off omits application HSTS if the tunnel/proxy sets it instead.
INTAKE_HSTS_MAX_AGE=31536000
# Include subdomains of the intake host; disable only if one must stay plain HTTP.
# INTAKE_HSTS_INCLUDE_SUBDOMAINS=true
# The compose stack defaults to cf-connecting-ip because web is meant to be reachable
# ONLY through the tunnel connector, which overwrites client-supplied copies.
# Set it to off if web can be reached any other way (IP spoofing risk).
# Empty or whitespace-only values stop startup instead of disabling the header.
INTAKE_CLIENT_IP_HEADER=cf-connecting-ip

# Existing external network shared only with the trusted tunnel connector.
INTAKE_TUNNEL_NETWORK=intake-tunnel
# Subnet of the stack's internal egress bridge (writer, bw). Pinned so Docker does not
# auto-assign a range overlapping the host's LAN (e.g. a home router LAN in
# 192.168.x.0/24). Must not overlap any network the host needs to reach.
# INTAKE_EGRESS_SUBNET=10.200.176.0/24
# Host side of web's published port (container port 3000), for a connector on the
# host network. Keep it loopback-only; 0.0.0.0, [::], a bare port, or a public
# address exposes web beyond this host. Empty or unset uses 127.0.0.1:3093.
INTAKE_WEB_BIND=127.0.0.1:3093
# Used as BW_SERVER by the bw container; use a canonical URL without a trailing /.
VAULT_URL=https://vault.example.com
BW_ORGANIZATION_ID=REPLACE_WITH_ORGANIZATION_ID
BW_COLLECTION_ID=REPLACE_WITH_COLLECTION_ID
# Maximum local bw serve response body bytes, including full collection lookups.
# Oversized lookup: unknown, no create; raise cap or move only done-ticket items out.
BW_MAX_RESPONSE_BYTES=1048576
# Writer-only persisted exponential backoff for pre-delivery retries and unknown resolution.
INTAKE_VAULT_RETRY_BASE_MS=5000
INTAKE_VAULT_RETRY_MAX_MS=300000
# Writer-only ticket_stuck warning threshold, integer 1-31; retries continue unchanged.
INTAKE_STUCK_ATTEMPTS=10
# Writer-only settle after ambiguous POST, completion-commit failure, or interrupted processing.
# Positive integer milliseconds, max 2147483647; delay is max(settle, backoff).
# Later lookup failures use backoff only; a new ambiguous POST restarts settle.
INTAKE_UNKNOWN_SETTLE_MS=120000
MAIL_API_URL=https://mail.example.com
MAIL_API_MAILBOX=intake@example.com

# Paths only. Provision contents and container-visible ownership as in README.md.
INTAKE_HMAC_KEY_PATH=./secrets/token_hmac_key
INTAKE_WRITER_KEY_PATH=./secrets/writer_master_key
INTAKE_FINGERPRINT_KEY_PATH=./secrets/fingerprint_key
MAIL_API_TOKEN_PATH=./secrets/mail_api_token
BW_CLIENTID_PATH=./secrets/bw_client_id
BW_CLIENTSECRET_PATH=./secrets/bw_client_secret
BW_PASSWORD_PATH=./secrets/bw_master_password
